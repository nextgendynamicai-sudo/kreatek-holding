{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/propuestapizza", "destination": "/propuestapizza/index.html" },
    { "source": "/propuestapizza/", "destination": "/propuestapizza/index.html" },
    { "source": "/pasareladepago", "destination": "/pasareladepago/index.html" },
    { "source": "/pasareladepago/", "destination": "/pasareladepago/index.html" }
  ]
}
